# Optional. Without a key: BM25 retrieval + extractive answers (the most relevant passages).
# With a key: hybrid retrieval (BM25 + embeddings) and generated answers with [n] citations.
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#            LLM_MODEL=gemini-3.8-flash  EMBEDDING_MODEL=gemini-embedding-001
#   OpenAI : LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=<model id>  EMBEDDING_MODEL=<embedding model id>
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
# Leave empty to use BM25 only (e.g. for providers without an embeddings endpoint, like Groq)
EMBEDDING_MODEL=gemini-embedding-001

STORAGE_DIR=storage
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150
BM25_PREFIX_LEN=5
SEED_SAMPLES=true
